{
  "name": "@itonami/tsumugi-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.tsumugi",
    "title": "Tsumugi",
    "storageKey": "itonami.tsumugi.v1",
    "description": "紡ぎ — 情報とエネルギーの流れが、どれだけ秩序を生んだかを、この端末で測ります。流れの記録から、正味の利得・秩序化の度合い・エージェントの効率をまとめます。成員になる準備ができた候補を、評議会の審査に回す「提案」として示します（決定はしません）。外部へは何も送信しません。",
    "cljsSources": [
      "../src"
    ],
    "storeId": "network.itonami.tsumugi"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
